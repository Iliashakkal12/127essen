# Wagti — environment variables
#
# Copy this file to .env.local for local development
# (cp .env.example .env.local) and fill in real values there.
# .env.local is gitignored — never commit real secrets.
#
# On Vercel: Project Settings → Environment Variables.

# Required. Server-side only — never exposed to the browser. Gates access to
# the private platform-owner dashboard at /admin. Pick a long random string,
# e.g. `openssl rand -base64 24`.
WAGTI_ADMIN_CODE=
